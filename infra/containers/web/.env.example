# ===== AWS / データリソース（必須） =====
AWS_REGION=us-east-1
DYNAMODB_TABLE=quality-report-reports
S3_BUCKET=
VECTOR_BUCKET=quality-report-vectors-us-east-1
VECTOR_INDEX=report-embeddings
# A2I フロー定義 ARN（任意。未設定時はレビュー画面の Human Loop 一覧を非表示）
FLOW_DEFINITION_ARN=
WORKTEAM_NAME=

# ===== Bedrock モデル ID（任意。未設定時は下記デフォルト） =====
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-sonnet-4-6

# ===== 認証（Better Auth / Cognito） =====
# ローカル開発では AUTH_ENABLED=false で認証をスキップできる
AUTH_ENABLED=false
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Cognito（AUTH_ENABLED=true のとき必須）
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=your-app.auth.us-east-1.amazoncognito.com
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
