        <mxCell id="sl1" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;ユーザーアクセス&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;利用者 -&gt; CloudFront (WAF + ACM) -&gt; Lambda Function URL (Next.js LWA, RESPONSE_STREAM)&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="1">
